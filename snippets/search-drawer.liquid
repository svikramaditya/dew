<search-drawer class="search-drawer" hidden>
  <div class="search-drawer__backdrop" data-search-close></div>
  <div class="search-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'search.title' | t }}">
    <div class="search-drawer__bar">
      {{ 'icon-search.svg' | inline_asset_content }}
      <input
        type="search"
        class="search-drawer__input"
        name="q"
        placeholder="{{ 'search.placeholder' | t }}"
        autocomplete="off"
        data-search-input
      >
      <button type="button" class="search-drawer__close" data-search-close aria-label="{{ 'general.close' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    {%- assign popular_terms = settings.popular_searches | split: ',' -%}
    <div class="search-drawer__popular">
      <span class="search-drawer__popular-label">{{ 'search.popular_searches' | t }}</span>
      {%- for term in popular_terms -%}
        <button type="button" class="search-drawer__chip" data-search-term>{{ term | strip }}</button>
      {%- endfor -%}
    </div>

    <div class="search-drawer__results" data-search-results>
      <p class="search-drawer__hint">{{ 'search.start_typing' | t }}</p>
    </div>
  </div>
</search-drawer>
