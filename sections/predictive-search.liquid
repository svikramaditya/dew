{%- if predictive_search.performed -%}
  {%- assign products = predictive_search.resources.results.products -%}
  {%- assign queries = predictive_search.resources.results.queries -%}

  {%- if queries.size > 0 -%}
    <div class="search-drawer__suggestions">
      <span class="search-drawer__popular-label">{{ 'search.suggestions' | t }}</span>
      <ul class="search-drawer__suggestion-list">
        {%- for query in queries -%}
          <li><button type="button" class="search-drawer__suggestion" data-search-term>{{ query.styled_text }}</button></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if products.size > 0 -%}
    <div class="search-drawer__results-header">
      <span>{{ 'search.title' | t }}</span>
    </div>
    <div class="search-drawer__results-grid">
      {%- for product in products -%}
        {% render 'product-card', product: product, card_product_loading: 'lazy' %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="search-drawer__hint">{{ 'search.no_results_html' | t: terms: predictive_search.terms }}</p>
  {%- endif -%}
{%- endif -%}
