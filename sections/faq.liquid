<div class="faq color-{{ section.settings.color_scheme }} full-width">
  <div class="faq__inner">
    <div class="faq__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="faq__eyebrow">
          <span class="faq__dot" aria-hidden="true"></span>
          {{ section.settings.eyebrow }}
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="faq__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a href="{{ section.settings.link_url | default: '#' }}" class="faq__link">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </div>

    <faq-accordion class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.shopify_attributes }}>
          <summary class="faq__question">
            <span>{{ block.settings.question }}</span>
            <span class="faq__icon">
              <span class="faq__icon-plus">{{ 'icon-plus.svg' | inline_asset_content }}</span>
              <span class="faq__icon-minus">{{ 'icon-minus.svg' | inline_asset_content }}</span>
            </span>
          </summary>
          <div class="faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </faq-accordion>
  </div>
</div>

<script src="{{ 'component-faq-accordion.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .faq__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-spacing) var(--page-margin);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media screen and (min-width: 900px) {
    .faq__inner {
      grid-template-columns: 1fr 1.4fr;
    }
  }

  .faq__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    opacity: 0.65;
    margin: 0 0 1.25rem;
  }

  .faq__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-button);
  }

  .faq__heading {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    margin: 0 0 1.5rem;
  }

  .faq__link {
    display: inline-block;
    font-size: 0.85rem;
    text-decoration: underline;
    color: var(--color-text);
  }

  .faq__list {
    display: block;
  }

  .faq__item {
    border-bottom: var(--border-thickness) solid var(--color-border);
    padding: 1.4rem 0;
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 500;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }

  .faq__icon-plus,
  .faq__icon-minus {
    position: absolute;
    inset: 0;
    transition: opacity 0.15s ease;
  }

  .faq__icon-minus {
    opacity: 0;
  }

  .faq__item[open] .faq__icon-plus {
    opacity: 0;
  }

  .faq__item[open] .faq__icon-minus {
    opacity: 1;
  }

  .faq__icon svg {
    width: 100%;
    height: 100%;
  }

  .faq__answer {
    margin-top: 1rem;
    font-size: 0.92rem;
    line-height: 1.6;
    opacity: 0.75;
    max-width: 38rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Got questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Everything you need to know"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:labels.link_label",
      "default": "Explore more FAQ"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "t:labels.link"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:labels.question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:labels.question"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "t:labels.answer"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Can I use this serum with retinol?",
            "answer": "We recommend alternating nights. Use the serum on one night, and retinol on another, to avoid irritation."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Is it safe for sensitive skin?",
            "answer": "Yes -- every formula is fragrance-free and patch-tested, but we always recommend a 24-hour patch test for new products."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How soon will I see results?",
            "answer": "Most people notice a difference in texture within 2-3 weeks of consistent use, with fuller results around 8 weeks."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Do I need to wear sunscreen with this product?",
            "answer": "Yes, especially with active ingredients like vitamin C or retinol -- always finish your morning routine with SPF."
          }
        }
      ]
    }
  ]
}
{% endschema %}
