{% comment %}
  This section is used in the article template to render the article page, which
  displays the full content of the blog post and can optionally include a
  comments section for customers (not shown in this example).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/article
{% endcomment %}
<div class="article color-{{ section.settings.color_scheme }} full-width">
  <div class="article__inner">
    {%- if article.image -%}
      <div class="article__media">
        {{ article.image | image_url: width: 1400 | image_tag: loading: 'eager', alt: article.title, class: 'article__image' }}
      </div>
    {%- endif -%}

    <div class="article__header">
      {%- if article.tags.size > 0 -%}
        <span class="article__tag">{{ article.tags.first | upcase }}</span>
      {%- endif -%}
      <h1 class="article__title">{{ article.title }}</h1>
      <p class="article__meta">{{ article.published_at | date: '%d %b, %Y' }} &middot; {{ article.author }}</p>
    </div>

    <div class="article__content">
      {{ article.content }}
    </div>

    {% if blog.comments_enabled? %}
      <div class="article__comments" id="comments">
        <h2 class="article__comments-title">{{ 'blog.article_comments' | t }}</h2>
        {% paginate article.comments by 10 %}
          {% for comment in article.comments %}
            <div class="article__comment">
              <p class="article__comment-author">{{ comment.author }}</p>
              <p class="article__comment-date">{{- comment.created_at | time_tag: format: 'date' -}}</p>
              <p>{{ comment.content }}</p>
            </div>
          {% endfor %}
          {{ paginate | default_pagination: anchor: 'comments' }}
        {% endpaginate %}
      </div>

      {% form 'new_comment', article, class: 'article__comment-form' %}
        <h2 class="article__comments-title">{{ 'blog.comment_form_title' | t }}</h2>
        {{ form.errors | default_errors }}
        <label for="author">{{ 'blog.comment_form_name' | t }}</label>
        <input type="text" name="comment[author]" id="author" value="{{ form.author }}" required>
        <label for="email">{{ 'blog.comment_form_email' | t }}</label>
        <input type="email" name="comment[email]" id="email" value="{{ form.email }}" required>
        <label for="body">{{ 'blog.comment_form_body' | t }}</label>
        <textarea name="comment[body]" id="body" required>{{ form.body }}</textarea>
        <input type="submit" value="{{ 'blog.comment_form_submit' | t }}" class="article__comment-submit">
      {% endform %}
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .article__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-spacing) var(--page-margin);
  }

  .article__media {
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-card);
    overflow: hidden;
    margin-bottom: 2.5rem;
  }

  .article__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article__header {
    max-width: 42rem;
    margin: 0 auto 2.5rem;
    text-align: center;
  }

  .article__tag {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-border) 50%, transparent);
    margin-bottom: 1rem;
  }

  .article__title {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    margin: 0 0 0.75rem;
  }

  .article__meta {
    font-size: 0.85rem;
    opacity: 0.6;
    margin: 0;
  }

  .article__content {
    max-width: 42rem;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.7;
  }

  .article__content img {
    border-radius: var(--radius-card);
  }

  .article__comments,
  .article__comment-form {
    max-width: 42rem;
    margin: 3rem auto 0;
  }

  .article__comments-title {
    font-size: 1.3rem;
    margin-bottom: 1.5rem;
  }

  .article__comment {
    padding: 1rem 0;
    border-bottom: var(--border-thickness) solid var(--color-border);
  }

  .article__comment-author {
    font-weight: 600;
    margin: 0;
  }

  .article__comment-date {
    font-size: 0.8rem;
    opacity: 0.6;
    margin: 0 0 0.5rem;
  }

  .article__comment-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article__comment-form input,
  .article__comment-form textarea {
    padding: 0.65rem 0.9rem;
    border: var(--border-thickness) solid var(--color-border);
    border-radius: var(--radius-input);
    font-family: inherit;
  }

  .article__comment-submit {
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.75rem 1.3rem;
    border: none;
    border-radius: var(--radius-button);
    background: var(--color-button);
    color: var(--color-button-label);
    cursor: pointer;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
