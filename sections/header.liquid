<header class="header color-{{ section.settings.color_scheme }} full-width">
  <div class="header__inner">
    <button type="button" class="header__menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="MobileMenu-{{ section.id }}" aria-label="{{ 'general.menu' | t }}">
      <span class="header__menu-icon"></span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 300 | image_tag: alt: shop.name, class: 'header__logo-image' }}
      {%- else -%}
        {{ shop.name }}
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'general.menu' | t }}">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="header__nav-link" {% if link.active %}aria-current="page"{% endif %}>
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>

    <div class="header__icons">
      <a href="{{ routes.search_url }}" class="header__icon-link" aria-label="{{ 'general.search' | t }}">
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon-link" aria-label="{{ 'general.account' | t }}">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header__icon-link header__cart-link" aria-label="{{ 'general.cart' | t }}">
        {{ 'icon-cart.svg' | inline_asset_content }}
        <span class="header__cart-count" {% if cart.item_count == 0 %}hidden{% endif %}>
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>

  <div class="header__mobile-menu" id="MobileMenu-{{ section.id }}" data-mobile-menu hidden>
    <nav aria-label="{{ 'general.menu' | t }}">
      {%- for link in section.settings.menu.links -%}
        <a href="{{ link.url }}" class="header__mobile-nav-link" {% if link.active %}aria-current="page"{% endif %}>
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>
  </div>
</header>

<script src="{{ 'component-mobile-menu.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .header__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 1.4rem var(--page-margin);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .header__menu-toggle {
    display: none;
    background: none;
    border: none;
    padding: 0.25rem;
    cursor: pointer;
  }

  .header__menu-icon,
  .header__menu-icon::before,
  .header__menu-icon::after {
    display: block;
    width: 1.35rem;
    height: 1.5px;
    background: var(--color-text);
    position: relative;
  }

  .header__menu-icon::before,
  .header__menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .header__menu-icon::before { top: -0.4rem; }
  .header__menu-icon::after { top: 0.4rem; }

  .header__logo {
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: 600;
    font-size: 1.5rem;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--color-text);
    white-space: nowrap;
  }

  .header__logo-image {
    height: 2rem;
    width: auto;
  }

  .header__nav {
    display: flex;
    gap: 2rem;
    flex: 1;
    justify-content: center;
  }

  .header__nav-link {
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .header__nav-link[aria-current='page'] {
    font-weight: 700;
  }

  .header__icons {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding-right: 0.55rem;
  }

  .header__icon-link {
    position: relative;
    display: flex;
    color: var(--color-text);
  }

  .header__icon-link svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .header__cart-count {
    position: absolute;
    top: -0.4rem;
    right: -0.55rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.2rem;
    border-radius: 999px;
    background: var(--color-button);
    color: var(--color-button-label);
    font-size: 0.62rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header__mobile-menu {
    border-top: var(--border-thickness) solid var(--color-border);
    padding: 1rem var(--page-margin) 1.5rem;
  }

  .header__mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .header__mobile-nav-link {
    display: block;
    padding: 0.75rem 0;
    text-decoration: none;
    color: var(--color-text);
    font-size: 1rem;
    border-bottom: var(--border-thickness) solid var(--color-border);
  }

  @media screen and (max-width: 749px) {
    .header__menu-toggle {
      display: block;
    }

    .header__nav {
      display: none;
    }

    .header__inner {
      justify-content: space-between;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:labels.image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
