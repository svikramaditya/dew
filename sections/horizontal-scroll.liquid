{%- liquid
  assign loading_strategy = 'lazy'
  unless settings.enable_lazy_loading
    assign loading_strategy = 'eager'
  endunless
  assign chosen_collection = collections[section.settings.collection]
-%}
<horizontal-scroll-section class="h-scroll color-{{ section.settings.color_scheme }} full-width">
  <div class="h-scroll__sticky">
    <div class="h-scroll__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="h-scroll__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="h-scroll__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="h-scroll__track" data-h-scroll-track>
      {%- for product in chosen_collection.products limit: section.settings.products_to_show -%}
        <div class="h-scroll__card">
          {% render 'product-card', product: product, card_product_loading: loading_strategy %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</horizontal-scroll-section>

<script src="{{ 'component-horizontal-scroll.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .h-scroll {
    display: block;
    position: relative;
    overflow-x: clip;
  }

  .h-scroll__sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 2rem 0;
  }

  .h-scroll__header {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    width: 100%;
    /* Set here, not on .h-scroll__description's own margin: a global
       reset zeroes a paragraph's margin-bottom when it's the last child
       of its container, which this one always is. */
    padding-bottom: 2rem;
  }

  .h-scroll__heading {
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    margin: 0 0 0.5rem;
  }

  .h-scroll__description {
    font-size: 1rem;
    opacity: 0.75;
    max-width: 32rem;
    margin: 0;
  }

  .h-scroll__track {
    display: flex;
    gap: var(--grid-gap);
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
    will-change: transform;
  }

  .h-scroll__card {
    flex: 0 0 min(20rem, 72vw);
  }

  @media (prefers-reduced-motion: reduce) {
    .h-scroll__sticky {
      position: relative;
      height: auto;
    }

    .h-scroll__track {
      overflow-x: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.horizontal_scroll",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Shop the full edit"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Keep scrolling -- every step of the routine, in one pass."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "t:general.horizontal_scroll"
    }
  ]
}
{% endschema %}
