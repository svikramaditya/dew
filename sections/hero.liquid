{% comment %}
  Homepage hero. The image behaves like a real water surface -- moving
  the pointer or clicking sends out genuine ripples that visibly
  refract the photo (WebGL height-field simulation, no video/gif).
  Degrades to a plain static image if WebGL is unavailable or the
  visitor prefers reduced motion.
{% endcomment %}
{%- liquid
  assign loading_strategy = 'lazy'
  unless settings.enable_lazy_loading
    assign loading_strategy = 'eager'
  endunless
-%}
<div class="hero color-{{ section.settings.color_scheme }} full-width">
  <div class="hero__inner">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="hero__description">{{ section.settings.description }}</p>
      {%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="hero__button hero__button--primary">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link | default: '#' }}" class="hero__button hero__button--secondary">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="hero__media">
      <water-ripple class="hero__ripple">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: widths: '800,1200,1600', sizes: '(min-width: 900px) 50vw, 100vw', loading: loading_strategy, alt: section.settings.heading, class: 'hero__image'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg hero__image' }}
        {%- endif -%}
      </water-ripple>
    </div>
  </div>
</div>

<script src="{{ 'component-water-ripple.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .hero__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-spacing) var(--page-margin);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  @media screen and (min-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr 1fr;
    }
  }

  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    opacity: 0.65;
    margin: 0 0 0.9rem;
  }

  .hero__heading {
    font-size: clamp(2.1rem, 1.6rem + 2vw, 3.4rem);
    line-height: 1.08;
    margin: 0 0 1.1rem;
  }

  .hero__description {
    font-size: 1.05rem;
    opacity: 0.8;
    max-width: 30rem;
    margin: 0 0 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .hero__button--primary {
    background: var(--color-button);
    color: var(--color-button-label);
  }

  .hero__button--secondary {
    background: transparent;
    color: var(--color-text);
    border: var(--border-thickness) solid var(--color-text);
  }

  .hero__media {
    position: relative;
  }

  .hero__ripple {
    display: block;
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-border) 40%, transparent);
    cursor: pointer;
  }

  .hero__image,
  .hero__ripple svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .water-ripple__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Care, composed for everyday"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Skin care that feels like a ritual"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Clean, considered formulas made with real ingredients -- nothing in here you can't pronounce."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "t:labels.link_label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "t:labels.link"
    }
  ],
  "presets": [
    {
      "name": "t:general.hero"
    }
  ]
}
{% endschema %}
