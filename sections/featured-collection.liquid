{%- liquid
  assign loading_strategy = 'lazy'
  unless settings.enable_lazy_loading
    assign loading_strategy = 'eager'
  endunless
  assign chosen_collection = collections[section.settings.collection]
-%}
<div class="featured-collection color-{{ section.settings.color_scheme }} full-width">
  <div class="featured-collection__inner">
    <div class="featured-collection__header">
      <div>
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="featured-collection__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: chosen_collection.url | default: '#' }}" class="featured-collection__view-all">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    <ul class="featured-collection__grid" style="--columns-desktop: {{ section.settings.columns_desktop }};">
      {%- for product in chosen_collection.products limit: section.settings.products_to_show -%}
        <li>{% render 'product-card', product: product, card_product_loading: loading_strategy %}</li>
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          <li class="product-card product-card--placeholder">
            <span class="product-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-card__image' }}
            </span>
            <span class="product-card__content">
              <span class="product-card__title">{{ 'general.product' | t }}</span>
              <span class="product-card__price">$0.00</span>
            </span>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .featured-collection__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-spacing) var(--page-margin);
  }

  .featured-collection__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .featured-collection__heading {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.4rem);
    line-height: 1.12;
    margin: 0 0 0.6rem;
  }

  .featured-collection__description {
    font-size: 1rem;
    opacity: 0.75;
    max-width: 32rem;
    margin: 0;
  }

  .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-text);
    border-bottom: var(--border-thickness) solid var(--color-text);
    padding-bottom: 0.15rem;
    white-space: nowrap;
  }

  .featured-collection__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--grid-gap);
  }

  @media screen and (min-width: 700px) {
    .featured-collection__grid {
      grid-template-columns: repeat(var(--columns-desktop, 3), 1fr);
    }
  }

  .product-card--placeholder {
    opacity: 0.5;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.featured_collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "The routine"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Six steps, built to be used in order -- or picked apart and used alone."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:labels.products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "t:labels.columns_desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.featured_collection"
    }
  ]
}
{% endschema %}
