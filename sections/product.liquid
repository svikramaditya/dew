{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}
{%- liquid
  assign loading_strategy = 'lazy'
  unless settings.enable_lazy_loading
    assign loading_strategy = 'eager'
  endunless
  assign current_variant = product.selected_or_first_available_variant
  assign swatch_shape = section.settings.swatch_shape
-%}
<div class="product color-{{ section.settings.color_scheme }} full-width">
  <div class="product__inner product__inner--{{ section.settings.gallery_layout }}">
    <product-gallery class="product__media" data-layout="{{ section.settings.gallery_layout }}">
      {%- if product.images.size > 0 -%}
        {%- if section.settings.gallery_layout == 'vertical' -%}
          <div class="product__thumbnails product__thumbnails--vertical" data-gallery-thumbs>
            {%- for image in product.images -%}
              {%- assign thumb_alt = image.alt | default: product.title -%}
              <button type="button" class="product__thumbnail{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="{{ 'products.view_image' | t }}">
                {{ image | image_url: width: 200 | image_tag: alt: thumb_alt, loading: 'lazy' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="product__media-main" data-gallery-main>
          {%- for image in product.images -%}
            {%- assign main_alt = image.alt | default: product.title -%}
            <div class="product__media-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide="{{ forloop.index0 }}">
              {{
                image
                | image_url: width: 1200
                | image_tag: widths: '600,900,1200', sizes: '(min-width: 900px) 50vw, 100vw', loading: loading_strategy, alt: main_alt, class: 'product__image'
              }}
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.gallery_layout == 'horizontal' -%}
          <div class="product__thumbnails product__thumbnails--horizontal" data-gallery-thumbs>
            {%- for image in product.images -%}
              {%- assign thumb_alt = image.alt | default: product.title -%}
              <button type="button" class="product__thumbnail{% if forloop.first %} is-active{% endif %}" data-gallery-thumb="{{ forloop.index0 }}" aria-label="{{ 'products.view_image' | t }}">
                {{ image | image_url: width: 200 | image_tag: alt: thumb_alt, loading: 'lazy' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product__image' }}
      {%- endif -%}
    </product-gallery>

    <div class="product__info">
      <h1 class="product__title">{{ product.title }}</h1>
      <p class="product__price" data-product-price>
        <span data-price-amount>{{ current_variant.price | money }}</span>
        <s class="product__price-compare" data-product-price-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s>
      </p>

      {%- if product.description != blank -%}
        <div class="product__description">{{ product.description }}</div>
      {%- endif -%}

      {% form 'product', product, class: 'product__form ajax-cart-form' %}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>

        {%- if product.has_only_default_variant == false -%}
          <variant-picker
            class="product__options"
            data-product-json="{{ product.variants | json | escape }}"
            data-swatch-shape="{{ swatch_shape }}"
          >
            {%- for option in product.options_with_values -%}
              <div class="product__option" data-option-position="{{ option.position }}">
                <label class="product__label">{{ option.name }}: <span data-selected-value>{{ option.selected_value }}</span></label>

                {%- assign has_swatch = false -%}
                {%- for value in option.values -%}
                  {%- if value.swatch.color or value.swatch.image -%}
                    {%- assign has_swatch = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}

                <div class="product__option-values{% if has_swatch %} product__option-values--swatch product__option-values--{{ swatch_shape }}{% endif %}">
                  {%- for value in option.values -%}
                    <button
                      type="button"
                      class="product__option-value{% if value.swatch.color or value.swatch.image %} product__option-value--swatch{% endif %}{% if value.selected %} is-selected{% endif %}{% unless value.available %} is-unavailable{% endunless %}"
                      data-option-value
                      data-option-position="{{ option.position }}"
                      data-value="{{ value.name | escape }}"
                      aria-label="{{ value.name }}"
                      {% if value.swatch.color %}style="--swatch-color: {{ value.swatch.color }};"{% endif %}
                    >
                      {%- if value.swatch.image -%}
                        <span class="product__option-value-image">{{ value.swatch.image | image_url: width: 80 | image_tag: loading: 'lazy', alt: value.name }}</span>
                      {%- elsif value.swatch.color -%}
                        <span class="product__option-value-swatch"></span>
                      {%- else -%}
                        <span class="product__option-value-label">{{ value.name }}</span>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </variant-picker>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endif -%}

        <p class="product__availability" data-product-availability hidden>{{ 'products.variant_unavailable' | t }}</p>

        <label class="product__label" for="Quantity-{{ section.id }}">{{ 'labels.quantity' | t }}</label>
        <input class="product__quantity" type="number" name="quantity" id="Quantity-{{ section.id }}" min="1" value="1">

        <button type="submit" class="product__button" data-product-submit {% unless current_variant.available %}disabled{% endunless %}>
          <span data-product-button-text>
            {%- if current_variant.available -%}
              {{ 'labels.add_to_cart' | t }}
            {%- else -%}
              {{ 'labels.sold_out' | t }}
            {%- endif -%}
          </span>
        </button>
        {{ form | payment_button }}
      {% endform %}

      {%- if section.blocks.size > 0 -%}
        <div class="product__accordions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <details class="product__accordion" {{ block.shopify_attributes }}>
                <summary class="product__accordion-title">
                  <span>{{ block.settings.title }}</span>
                  <span class="product__accordion-icon">
                    <span class="product__accordion-plus">{{ 'icon-plus.svg' | inline_asset_content }}</span>
                    <span class="product__accordion-minus">{{ 'icon-minus.svg' | inline_asset_content }}</span>
                  </span>
                </summary>
                <div class="product__accordion-content">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  <div data-product-recommendations-mount data-url="{{ routes.product_recommendations_url }}?section_id=product-recommendations&product_id={{ product.id }}&limit=4&intent=related"></div>
  <span data-current-product-handle="{{ product.handle }}" hidden></span>
</div>

<script src="{{ 'component-product-gallery.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-variant-picker.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'component-recently-viewed.js' | asset_url }}" defer="defer"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    var mount = document.querySelector('[data-product-recommendations-mount]');
    if (!mount) return;
    fetch(mount.dataset.url)
      .then(function (res) { return res.text(); })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var content = doc.querySelector('[data-product-recommendations]');
        if (content) mount.replaceWith(content);
      })
      .catch(function () {});
  });
</script>

{% stylesheet %}
  .product__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-spacing) var(--page-margin);
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media screen and (min-width: 900px) {
    .product__inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }

  .product__media {
    display: block;
  }

  .product__inner--horizontal .product__media,
  .product__inner--stacked .product__media {
    display: flex;
    flex-direction: column;
  }

  .product__inner--vertical .product__media {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
  }

  @media screen and (max-width: 599px) {
    .product__inner--vertical .product__media {
      grid-template-columns: 1fr;
    }

    .product__inner--vertical .product__thumbnails--vertical {
      order: 2;
      flex-direction: row;
      overflow-x: auto;
    }
  }

  .product__media-main {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: color-mix(in srgb, var(--color-border) 40%, transparent);
  }

  .product__inner--stacked .product__media-main {
    aspect-ratio: auto;
    display: flex;
    flex-direction: column;
    gap: var(--grid-gap);
    background: none;
    border-radius: 0;
  }

  /*
   * Absolutely positioned to fill .product__media-main (which carries
   * the real aspect-ratio box) - without this, a block-level slide
   * with no explicit height has nothing for the image's `height: 100%`
   * to resolve against, so the image falls back to its own natural
   * aspect ratio scaled to the available width instead of covering
   * the frame, leaving blank space below it.
   */
  .product__media-slide {
    display: none;
    position: absolute;
    inset: 0;
  }

  .product__media-slide.is-active {
    display: block;
  }

  .product__inner--stacked .product__media-slide {
    display: block;
    position: static;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .product__image,
  .product__media-main svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__media-main svg {
    position: absolute;
    inset: 0;
  }

  .product__thumbnails {
    display: flex;
    gap: 0.75rem;
  }

  .product__thumbnails--horizontal {
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .product__thumbnails--vertical {
    flex-direction: column;
    max-height: 32rem;
    overflow-y: auto;
  }

  .product__thumbnail {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    flex-shrink: 0;
    border-radius: var(--radius-input);
    overflow: hidden;
    border: var(--border-thickness) solid var(--color-border);
    padding: 0;
    cursor: pointer;
    background: none;
    opacity: 0.6;
    transition: opacity 0.2s ease, border-color 0.2s ease;
  }

  .product__thumbnail.is-active {
    opacity: 1;
    border-color: var(--color-text);
  }

  .product__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product__title {
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.3rem);
    line-height: 1.12;
    margin: 0 0 0.75rem;
  }

  .product__price {
    font-size: 1.15rem;
    margin: 0 0 1.5rem;
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .product__price-compare {
    opacity: 0.55;
    font-size: 0.95rem;
  }

  .product__description {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.85;
    margin-bottom: 2rem;
    max-width: 34rem;
  }

  .product__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 26rem;
  }

  .product__variant-select,
  .product__quantity {
    padding: 0.7rem 0.9rem;
    border: var(--border-thickness) solid var(--color-border);
    border-radius: var(--radius-input);
    background: var(--color-background);
    color: var(--color-text);
  }

  .product__button {
    margin-top: 1.5rem;
    padding: 0.95rem 1.6rem;
    border: none;
    border-radius: var(--radius-button);
    background: var(--color-button);
    color: var(--color-button-label);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
  }

  .product__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .product__accordions {
    margin-top: 2rem;
    max-width: 26rem;
  }

  .product__accordion {
    border-top: var(--border-thickness) solid var(--color-border);
    padding: 1rem 0;
  }

  .product__accordion:last-child {
    border-bottom: var(--border-thickness) solid var(--color-border);
  }

  .product__accordion-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 600;
    list-style: none;
  }

  .product__accordion-title::-webkit-details-marker {
    display: none;
  }

  .product__accordion-icon {
    position: relative;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .product__accordion-plus,
  .product__accordion-minus {
    position: absolute;
    inset: 0;
    transition: opacity 0.15s ease;
  }

  .product__accordion-minus {
    opacity: 0;
  }

  .product__accordion[open] .product__accordion-plus {
    opacity: 0;
  }

  .product__accordion[open] .product__accordion-minus {
    opacity: 1;
  }

  .product__accordion-content {
    margin-top: 0.75rem;
    font-size: 0.88rem;
    line-height: 1.6;
    opacity: 0.8;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "t:labels.gallery_layout",
      "options": [
        { "value": "horizontal", "label": "t:labels.gallery_horizontal" },
        { "value": "vertical", "label": "t:labels.gallery_vertical" },
        { "value": "stacked", "label": "t:labels.gallery_stacked" }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "swatch_shape",
      "label": "t:labels.swatch_shape",
      "options": [
        { "value": "round", "label": "t:labels.round" },
        { "value": "square", "label": "t:labels.square" }
      ],
      "default": "round"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "t:labels.accordion",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title",
          "default": "Shipping & returns"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:labels.content"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
