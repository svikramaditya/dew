{%- if section.settings.enable -%}
  <newsletter-popup
    class="newsletter-popup color-{{ section.settings.color_scheme }}"
    hidden
    data-delay="{{ section.settings.delay_seconds | times: 1000 }}"
  >
    <div class="newsletter-popup__backdrop" data-popup-close></div>
    <div class="newsletter-popup__panel" role="dialog" aria-modal="true">
      <button type="button" class="newsletter-popup__close" data-popup-close aria-label="{{ 'general.close' | t }}">
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
      <div class="newsletter-popup__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: section.settings.heading }}
        {%- endif -%}
      </div>
      <div class="newsletter-popup__content">
        {%- if section.settings.heading != blank -%}
          <h2 class="newsletter-popup__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <p class="newsletter-popup__description">{{ section.settings.description }}</p>
        {%- endif -%}

        {% form 'customer' %}
          {%- if form.posted_successfully? -%}
            <p class="newsletter-popup__success">{{ 'general.newsletter.success' | t }}</p>
          {%- else -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter-popup__field">
              <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.email_placeholder' | t }}" required>
              <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
            </div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </newsletter-popup>

  <script src="{{ 'component-newsletter-popup.js' | asset_url }}" defer="defer"></script>

  {% stylesheet %}
    .newsletter-popup {
      position: fixed;
      inset: 0;
      z-index: 97;
    }

    .newsletter-popup__backdrop {
      position: fixed;
      inset: 0;
      background: rgba(20, 16, 12, 0.45);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .newsletter-popup.is-open .newsletter-popup__backdrop {
      opacity: 1;
    }

    .newsletter-popup__panel {
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -46%);
      width: min(44rem, 92vw);
      max-height: 85vh;
      overflow: hidden;
      background: var(--color-background);
      color: var(--color-text);
      border-radius: var(--radius-card);
      opacity: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      display: grid;
      grid-template-columns: 1fr;
    }

    @media screen and (min-width: 650px) {
      .newsletter-popup__panel {
        grid-template-columns: 1fr 1fr;
      }
    }

    .newsletter-popup.is-open .newsletter-popup__panel {
      opacity: 1;
      transform: translate(-50%, -50%);
    }

    .newsletter-popup__close {
      position: absolute;
      top: 1rem;
      right: 1rem;
      z-index: 2;
      background: color-mix(in srgb, var(--color-background) 70%, transparent);
      border: none;
      border-radius: 999px;
      width: 2rem;
      height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--color-text);
    }

    .newsletter-popup__close svg {
      width: 0.9rem;
      height: 0.9rem;
    }

    .newsletter-popup__media {
      display: none;
      background: color-mix(in srgb, var(--color-border) 40%, transparent);
    }

    @media screen and (min-width: 650px) {
      .newsletter-popup__media {
        display: block;
      }
    }

    .newsletter-popup__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .newsletter-popup__content {
      padding: 2.5rem;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .newsletter-popup__heading {
      font-size: 1.6rem;
      margin: 0 0 0.75rem;
    }

    .newsletter-popup__description {
      font-size: 0.92rem;
      opacity: 0.75;
      margin: 0 0 1.5rem;
    }

    .newsletter-popup__field {
      display: flex;
      gap: 0.5rem;
    }

    .newsletter-popup__field input {
      flex: 1;
      padding: 0.75rem 0.9rem;
      border: var(--border-thickness) solid var(--color-border);
      border-radius: var(--radius-input);
    }

    .newsletter-popup__field button {
      padding: 0.75rem 1.3rem;
      border: none;
      border-radius: var(--radius-button);
      background: var(--color-button);
      color: var(--color-button-label);
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
    }
  {% endstylesheet %}
{%- endif -%}

{% schema %}
{
  "name": "t:general.newsletter_popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "t:labels.enable_popup",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "label": "t:labels.delay_seconds",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 6
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:labels.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Get 10% off your first order"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.description",
      "default": "Subscribe for early access to new formulas, skin tips, and a welcome discount."
    }
  ]
}
{% endschema %}
