{%- liquid
  assign words = section.settings.text | split: ' '
-%}
<div class="philosophy color-{{ section.settings.color_scheme }} full-width">
  <div class="philosophy__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="philosophy__eyebrow">
        <span class="philosophy__dot" aria-hidden="true"></span>
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    <scroll-reveal-text class="philosophy__text">
      {%- for word in words -%}
        <span class="philosophy__word">{{ word }}{% unless forloop.last %}&nbsp;{% endunless %}</span>
      {%- endfor -%}
    </scroll-reveal-text>
  </div>
</div>

<script src="{{ 'component-scroll-reveal-text.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .philosophy__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--section-spacing) var(--page-margin);
  }

  .philosophy__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.78rem;
    opacity: 0.65;
    margin: 0 0 2rem;
  }

  .philosophy__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--color-button);
  }

  .philosophy__text {
    display: block;
    font-family: var(--font-heading--family);
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 3rem);
    line-height: 1.3;
    max-width: 58rem;
  }

  .philosophy__word {
    opacity: 0.3;
    transition: opacity 0.2s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .philosophy__word {
      opacity: 1;
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.philosophy",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our philosophy"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:labels.description",
      "default": "We believe skincare should feel intuitive, not complicated. Our formulas combine modern dermatological research with gentle, skin-supportive ingredients -- crafted for real routines and real results."
    }
  ],
  "presets": [
    {
      "name": "t:general.philosophy"
    }
  ]
}
{% endschema %}
