<div class="video-section color-{{ section.settings.color_scheme }} full-width">
  <div class="video-section__media">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1600x', class: 'video-section__video' }}
    {%- elsif section.settings.cover_image != blank -%}
      {{ section.settings.cover_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: section.settings.heading, class: 'video-section__image' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg video-section__image' }}
    {%- endif -%}
    <div class="video-section__overlay">
      {%- if section.settings.eyebrow != blank -%}
        <p class="video-section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="video-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="video-section__button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .video-section__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  @media screen and (min-width: 900px) {
    .video-section__media {
      aspect-ratio: 21 / 9;
    }
  }

  .video-section__video,
  .video-section__image,
  .video-section__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-section__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 1rem;
    padding: 2rem;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.35), rgba(0, 0, 0, 0.1));
    color: #fff;
  }

  .video-section__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.78rem;
    opacity: 0.85;
    margin: 0;
  }

  .video-section__heading {
    font-size: clamp(1.8rem, 1.4rem + 2vw, 3rem);
    margin: 0;
    max-width: 40rem;
  }

  .video-section__button {
    display: inline-flex;
    margin-top: 0.5rem;
    padding: 0.85rem 1.6rem;
    border-radius: var(--radius-button);
    background: #fff;
    color: #1a1a1a;
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.video",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:labels.video"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "t:labels.cover_image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Begins with a drop"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:labels.button_label",
      "default": "Learn more about us"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:labels.button_link"
    }
  ],
  "presets": [
    {
      "name": "t:general.video"
    }
  ]
}
{% endschema %}
