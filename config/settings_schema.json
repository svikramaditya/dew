[
  {
    "name": "theme_info",
    "theme_name": "Dew",
    "theme_version": "0.1.0",
    "theme_author": "Dew",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "karla_n4",
        "label": "t:labels.primary_font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "ebgaramond_n4",
        "label": "t:labels.heading_font"
      },
      {
        "type": "header",
        "content": "t:labels.scale"
      },
      {
        "type": "range",
        "id": "body_scale",
        "min": 85,
        "max": 115,
        "step": 1,
        "unit": "%",
        "label": "t:labels.body_scale",
        "default": 100
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 85,
        "max": 130,
        "step": 1,
        "unit": "%",
        "label": "t:labels.heading_scale",
        "default": 100
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "72rem", "label": "t:options.page_width.narrow" },
          { "value": "82rem", "label": "t:options.page_width.medium" },
          { "value": "92rem", "label": "t:options.page_width.wide" }
        ],
        "default": "82rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 80,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 0,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "t:labels.section_spacing",
        "default": 88
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 0,
        "max": 48,
        "step": 4,
        "unit": "px",
        "label": "t:labels.grid_gap",
        "default": 24
      }
    ]
  },
  {
    "name": "t:general.shape",
    "settings": [
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.button_corner_radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 40,
        "step": 1,
        "unit": "px",
        "label": "t:labels.card_corner_radius",
        "default": 16
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "border_thickness",
        "min": 0,
        "max": 4,
        "step": 1,
        "unit": "px",
        "label": "t:labels.border_thickness",
        "default": 1
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:labels.color_schemes_info"
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "t:labels.background", "default": "#F7F3EC" },
          { "type": "color", "id": "text", "label": "t:labels.text", "default": "#2B2420" },
          { "type": "color", "id": "border", "label": "t:labels.border", "default": "#E3DACD" },
          { "type": "color", "id": "button", "label": "t:labels.button_background", "default": "#5C6E51" },
          { "type": "color", "id": "button_label", "label": "t:labels.button_text", "default": "#F7F3EC" }
        ],
        "role": {
          "background": "background",
          "text": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text",
          "links": "text",
          "icons": "text"
        }
      }
    ]
  },
  {
    "name": "t:general.animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_scroll_animations",
        "label": "t:labels.enable_scroll_animations",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_lazy_loading",
        "label": "t:labels.enable_lazy_loading",
        "default": true
      }
    ]
  }
]
